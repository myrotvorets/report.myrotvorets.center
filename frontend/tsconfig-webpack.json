{
    "compilerOptions": {
        "target": "ES2019",
        "module": "Node16",
        "moduleResolution": "Node16",
        "types": ["node"],
        "sourceMap": false,
        "strict": true,
        "noUnusedLocals": false,
        "noUnusedParameters": false,
        "noFallthroughCasesInSwitch": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "skipDefaultLibCheck": true
    },
    "include": ["webpack.*.ts", ".webpack/*.ts"],
    "compileOnSave": true
}
