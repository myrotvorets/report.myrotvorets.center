    "@types/archiver": "^8.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "archiver": "^8.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-validator": "^7.3.2",
    "fetch-retry-ts": "^1.3.1",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@myrotvorets/eslint-config-myrotvorets-ts": "^4.0.0",
    "eslint-formatter-gha": "^2.0.1",
    "typescript": "^6.0.0"
  },
  "private": true,
  "description": "Cloud Functions for https://report.myrotvorets.center/",
