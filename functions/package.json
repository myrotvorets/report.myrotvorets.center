{
  "name": "functions",
  "scripts": {
    "lint": "eslint -f gha .",
    "lint:fix": "eslint --fix .",
    "prebuild": "npm run lint",
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
